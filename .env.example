# Telegram Bot
BOT_TOKEN=your_bot_token_from_botfather
ADMIN_IDS=123456789,987654321

# Группа с топиками (Forum) — админка как на скриншоте
# 1. Создайте супергруппу → включите «Темы»
# 2. Добавьте бота админом (право «Управление топиками»)
# 3. Узнайте ID через @RawDataBot
ADMIN_GROUP_ID=-1001234567890
BOT_DISPLAY_NAME=Видеоролики недвижимость

# Web Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password
SECRET_KEY=change_me_random_secret_key_for_sessions

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Server
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Railway: добавьте переменные в Dashboard → Variables
# RAILWAY_VOLUME_MOUNT_PATH=/data  (если подключён Volume)
